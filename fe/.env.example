# 백엔드 호스트 설정 템플릿. 복사해서 .env 로 쓴다.
#   cp .env.example .env
#
# .env, .env.production 은 모두 git 에 올리지 않는다 (이 파일만 커밋된다).
# 배포 빌드에 쓰이는 VITE_API_BASE_URL 은 GitHub 리포지토리 Secrets 에서 주입된다.
#   Settings > Secrets and variables > Actions > Secrets
#
# 우선순위: .env.production (build) > .env (dev/공통)
# VITE_* 는 빌드 시점에 번들에 인라인된다. 런타임 환경변수가 아니므로
# Azure App Service 애플리케이션 설정에 넣어도 프론트에는 반영되지 않는다.
# 비밀값(토큰, 커넥션 스트링)은 절대 VITE_* 로 두지 말 것 — 브라우저에 그대로 노출된다.

# 백엔드 절대 주소. 비워두면 상대경로 + vite 프록시(개발)로 동작한다.
VITE_API_BASE_URL=

# vite dev server 프록시 대상 (로컬 be 주소)
VITE_PROXY_TARGET=http://127.0.0.1:3000
